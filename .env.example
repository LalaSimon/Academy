# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy
DATABASE_URL="postgresql://academy:academy@localhost:5432/academy"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=academy-files

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Klucz API z https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adres nadawcy — domena musi być zweryfikowana w Resend (dev: onboarding@resend.dev)
MAIL_FROM=Academy <noreply@twoja-domena.pl>

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
# Email admina — dostaje powiadomienia o nowych rejestracjach
ADMIN_EMAIL=admin@twoja-domena.pl
# Domena dla kont dzieci (login identifier, nie prawdziwa skrzynka)
CHILD_EMAIL_DOMAIN=academy.pl

# ─── Limity żądań ─────────────────────────────────────────────────────────────
# Liczba żądań na minutę. Puste = wartości produkcyjne z kodu (apps/api/src/
# common/throttling/throttle.config.ts). Limity są GLOBALNE — obejmują każdą
# trasę, nie tylko auth.
#
# W dev i CI podnoszone (docker-compose.yml / ci.yml), bo zestaw E2E wykonuje
# setki żądań z jednego adresu w kilkadziesiąt sekund.
#
# IP_THROTTLE_LIMIT=600        # sufit na adres IP, wspólny dla wszystkich tras
# GLOBAL_THROTTLE_LIMIT=120    # warstwa robocza, per tożsamość i trasa
# AUTH_THROTTLE_LIMIT=10       # logowanie, reset hasła, weryfikacja tokenu
# MAIL_THROTTLE_LIMIT=3        # wszystko, co wysyła maila
# UPLOAD_THROTTLE_LIMIT=10     # wgrywanie materiałów
# DOWNLOAD_THROTTLE_LIMIT=60   # pobieranie plików (egress!)
# REPORT_THROTTLE_LIMIT=5      # generowanie XLSX
# CHECKOUT_THROTTLE_LIMIT=5    # tworzenie sesji Stripe

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Liczba warstw reverse proxy przed API. 0 = brak proxy (dev, docker compose).
# ZA PROXY TRZEBA TO USTAWIĆ — inaczej limity liczą się po adresie proxy, czyli
# wspólnym dla wszystkich, i pierwszy user wyczerpujący limit blokuje resztę.
# Świadomie liczba, nie `true`: `true` każe ufać całemu X-Forwarded-For, który
# klient może dopisać sam, co czyni limity obchodzalnymi jednym nagłówkiem.
TRUST_PROXY_HOPS=0
# AUTH_THROTTLE_LIMIT=10
# MAIL_THROTTLE_LIMIT=3

# ─── Google Meet (opcjonalne) ─────────────────────────────────────────────────
# Automatyczne linki Meet dla nowych zajęć. Domyślnie WYŁĄCZONE — bez tego
# link wpisuje się ręcznie przy tworzeniu zajęć, tak jak dotąd.
# Instrukcja konfiguracji: docs/GOOGLE_MEET.md
# GOOGLE_CALENDAR_ENABLED=true
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...
# Kalendarz, w którym powstają wydarzenia (domyślnie główny kalendarz konta)
# GOOGLE_CALENDAR_ID=primary
